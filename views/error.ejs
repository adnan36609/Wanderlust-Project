<% layout("/layouts/boilerplate") %>

<div class="row mt-5">
    <div class="col-10 col-md-8 col-lg-6 offset-1 offset-md-2 offset-lg-3">
        <div class="alert alert-danger text-center p-4" role="alert">
            <h2 class="alert-heading mb-3">Something went wrong</h2>

            <p class="mb-4">
                <%= err.message.includes("Cast to ObjectId failed")
                    ? "The listing you're looking for doesn't exist or may have been removed."
                    : err.message %>
            </p>

            <a href="/listings" class="btn btn-dark">
                Back to Listings
            </a>
        </div>
    </div>
</div>