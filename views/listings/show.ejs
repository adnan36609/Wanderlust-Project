<% layout('/layouts/boilerplate') %>
<script>
    const mapToken= "<%= mapToken %>";
    const coordinates= <%- JSON.stringify(listing.geometry.coordinates) %>;
    const listingTitle= <%- JSON.stringify(listing.title) %>;
</script>

<div class="row mt-4">
    <div class="col-md-7 mx-auto">
        <h2 class="mb-3"><%= listing.title %></h2>
        <div class="card border-0 shadow-sm rounded listing-card">
            <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="Listing Image">
            <div class="card-body p-4">

                <p class="card-text mb-3 text-secondary"><i>Listed by: <%= listing.owner.username %></i></p>
                <p class="card-text mb-3"><%= listing.description %></p>
                <p class="mb-2"><strong>₹<%= listing.price.toLocaleString("en-IN") %>/night</strong></p>
                <p class="mb-1"><%= listing.location %></p>
                <p class="mb-4"><%= listing.country %></p>

            <% if (currentUser && listing.owner && currentUser._id.equals(listing.owner._id)) { %>
                <div class="d-flex gap-3">
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>
                    <form method="post" action="/listings/<%= listing._id %>?_method=delete" class="m-0">
                        <button class="btn btn-danger">Delete</button>
                    </form>
                </div>
            <% } %>
            </div>
        </div>
        <% if(currentUser){ %>
        <!--Add new Reviews -->
        <hr>
        <div class="row mt-4">
            <h4 class="mb-3 mt-4">Leave a Review</h4>
            <form action="/listings/<%= listing._id %>/reviews" method="post" class="mb-4 needs-validation" novalidate>
                <div class="rating form-label mb-1 mt-3">
                    <fieldset class="starability-grow">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>
                
                <div class="comment form-label mb-3 mt-1">
                    <label for="comment">Comment</label>
                    <textarea name="review[comment]" id="comment" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please add comments for a review.</div>
                </div>
                <div class="review-submit-button form-label mb-3 mt-3">
                    <button class="btn btn-danger form-control">Submit</button>
                </div>
            </form>
        </div>
        <% } %>

        <!--All Reviews -->
        <% if(listing.reviews.length>0){ %>
        <hr>
        <div class="row g-4 mt-3">
            <h4 class="mb-3 mt-3">All Reviews</h4>
            <% for(review of listing.reviews){ %>
                <div class="col-md-6 col-lg-6 mb-4">
                    <div class="card review-card h-100 mb-3">
                        <div class="card-body mt-3 ml-4">
                            <h5 class="card-title fw-bold mb-3">@<%= review.author.username %></h5>
                            <p class="starability-result" data-rating="<%= review.rating %>">  </p>
                            <p class="card-text text-secondary"><%= review.comment %></p>
                        </div>
                        <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
                            <button class="btn btn-dark btn-sm offset-9 mb-2">Delete</button>
                        </form>
                    </div>
                </div>
            <% } %>
        </div>
        <% } %>
        <div class="row g-4 mt-3 mb-5">
            <h4>Where you'll be</h4>
            <div id="map"></div>

        </div>
    </div>
</div>

<script src="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js"></script>
<script src="/JS/map.js"></script>