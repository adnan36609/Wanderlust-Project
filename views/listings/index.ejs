<% layout('/layouts/boilerplate') %>

<div class="filter-container">

    <div class="container d-flex align-items-center">

        <button class="filter-btn filter-btn-left" aria-label="Previous">
            <i class="fa-solid fa-chevron-left"></i>
        </button>

        <div class="filter-scroll">
            <div class="filters">

    <a href="/listings?category=Trending" class="filter <%= activeCategory === 'Trending' ? 'active' : '' %>">
        <i class="fa-solid fa-fire-flame-curved"></i>
        <p>Trending</p>
    </a>

    <a href="/listings?category=Iconic Cities" class="filter <%= activeCategory === 'Iconic Cities' ? 'active' : '' %>">
        <i class="fa-solid fa-archway"></i>
        <p>Iconic Cities</p>
    </a>

    <a href="/listings?category=Luxe" class="filter <%= activeCategory === 'Luxe' ? 'active' : '' %>">
        <i class="fa-regular fa-gem"></i>
        <p>Luxe</p>
    </a>

    <a href="/listings?category=Mountains" class="filter <%= activeCategory === 'Mountains' ? 'active' : '' %>">
        <i class="fa-solid fa-mountain-sun"></i>
        <p>Mountains</p>
    </a>

    <a href="/listings?category=Castles" class="filter <%= activeCategory === 'Castles' ? 'active' : '' %>">
        <i class="fa-brands fa-fort-awesome"></i>
        <p>Castles</p>
    </a>

    <a href="/listings?category=Pools" class="filter <%= activeCategory === 'Pools' ? 'active' : '' %>">
        <i class="fa-solid fa-person-swimming"></i>
        <p>Pools</p>
    </a>

    <a href="/listings?category=Camping" class="filter <%= activeCategory === 'Camping' ? 'active' : '' %>">
        <i class="fa-solid fa-campground"></i>
        <p>Camping</p>
    </a>

    <a href="/listings?category=Boats" class="filter <%= activeCategory === 'Boats' ? 'active' : '' %>">
        <i class="fa-solid fa-sailboat"></i>
        <p>Boats</p>
    </a>

    <a href="/listings?category=Beaches" class="filter <%= activeCategory === 'Beaches' ? 'active' : '' %>">
        <i class="fa-solid fa-umbrella-beach"></i>
        <p>Beaches</p>
    </a>

    <a href="/listings?category=Pet Friendly" class="filter <%= activeCategory === 'Pet Friendly' ? 'active' : '' %>">
        <i class="fa-solid fa-paw"></i>
        <p>Pet Friendly</p>
    </a>

</div>
        </div>

        <button class="filter-btn filter-btn-right" aria-label="Next">
            <i class="fa-solid fa-chevron-right"></i>
        </button>

        <div class="tax-toggle">
            <div class="form-check form-switch form-check-reverse m-0">
                <input class="form-check-input" type="checkbox" id="switchCheckReverse">
                <label class="form-check-label" for="switchCheckReverse">
                    Display total after taxes
                </label>
            </div>
        </div>

    </div>

</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 listing-grid">
    <% for(let listing of all_listings){ %>

    <a href="/listings/<%= listing.id %>" class="card-link">

        <div class="card col h-100 listing-card">

            <img
                src="<%= listing.image.url %>"
                class="card-img-top"
                alt="<%= listing.title %>"
            >

            <div class="card-img-overlay"></div>

            <div class="card-body">

                <h5 class="card-title">
                    <b><%= listing.title %></b>
                </h5>

<p class="card-text">
    <span class="price-original">
        &#8377;
        <%= listing.price != null ? listing.price.toLocaleString("en-IN") : "N/A" %>
        /night
    </span>

    <span class="price-with-tax" style="display: none;">
        &#8377;
        <%= listing.price != null
            ? Math.round(listing.price * 1.18).toLocaleString("en-IN")
            : "N/A" %>
        /night
    </span>

    <i class="tax-info">(+18% GST)</i>
</p>

            </div>

        </div>

    </a>

    <% } %>
</div>

<script>
    const taxSwitch = document.getElementById("switchCheckReverse");

    taxSwitch.addEventListener("change", () => {
        const originalPrices = document.getElementsByClassName("price-original");
        const taxPrices = document.getElementsByClassName("price-with-tax");
        const taxInfo = document.getElementsByClassName("tax-info");

        for (let i = 0; i < originalPrices.length; i++) {
            if (taxSwitch.checked) {
                originalPrices[i].style.display = "none";
                taxPrices[i].style.display = "inline";
                taxInfo[i].style.display = "none";
            } else {
                originalPrices[i].style.display = "inline";
                taxPrices[i].style.display = "none";
                taxInfo[i].style.display = "inline";
            }
        }
    });

    const filterScroll = document.querySelector(".filter-scroll");

    document.querySelector(".filter-btn-right").addEventListener("click", () => {
        filterScroll.scrollBy({
            left: 300,
            behavior: "smooth"
        });
    });

    document.querySelector(".filter-btn-left").addEventListener("click", () => {
        filterScroll.scrollBy({
            left: -300,
            behavior: "smooth"
        });
    });
</script>